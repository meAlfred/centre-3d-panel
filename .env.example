# Copy to .env and change what you need. Every value is optional.

# Where the dashboard listens. 0.0.0.0 = every interface on the host.
# Put a single IP here (e.g. your LAN or Tailscale address) to restrict it.
LISTEN_ADDRESS=0.0.0.0
WEB_PORT=9110

# Internal agent port, loopback only. Change it only if 9108 is taken.
AGENT_PORT=9108

# Name in the header. Default: the host's /etc/hostname.
HOST_NAME=

# Host used for "open in browser" links on container ports.
# Default: whatever address you opened the dashboard with.
PUBLIC_HOST=

# Uptime Kuma (optional): full URL of its /metrics endpoint plus an API key
# (Settings → API Keys), or username/password on older versions.
# Wrap passwords containing $ in single quotes.
KUMA_METRICS_URL=
KUMA_API_KEY=
KUMA_USERNAME=
KUMA_PASSWORD=

# Image tag to run.
CENTRE_VERSION=latest
